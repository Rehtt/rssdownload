# Required. Use different, strong values for both secrets.
RSSDOWNLOAD_ADMIN_PASSWORD=
ARIA2_RPC_SECRET=

# Optional runtime settings.
RSSDOWNLOAD_ADMIN_USERNAME=admin
RSSDOWNLOAD_PORT=8080
RSSDOWNLOAD_COOKIE_SECURE=false
RSSDOWNLOAD_TRUSTED_PROXIES=

# Optional OIDC: leave all five empty to disable; otherwise fill all five.
# Register this exact callback with the provider: https://rss.example.com/api/v1/auth/oidc/callback
# HTTP is allowed only for localhost / loopback development URLs.
# Request openid email; the provider must supply a verified email in ID Token or UserInfo.
RSSDOWNLOAD_OIDC_ISSUER_URL=
RSSDOWNLOAD_OIDC_CLIENT_ID=
RSSDOWNLOAD_OIDC_CLIENT_SECRET=
RSSDOWNLOAD_OIDC_REDIRECT_URL=
# Comma-separated complete email addresses; no domains or wildcards.
RSSDOWNLOAD_OIDC_ALLOWED_EMAILS=

ARIA2_BT_PORT=6881
ARIA2_CACHE=512M
ARIA2_FILE_ALLOCATION=falloc
ARIA2_A2B_DISABLE_LOG=true
PUID=1000
PGID=1000
TZ=Asia/Shanghai
